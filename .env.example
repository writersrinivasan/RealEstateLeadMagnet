# Optional. Normally users bring their own Groq key in the UI (⚙️ Settings, stored in their browser).
# If set, this is used as a server-side fallback when no BYOK key is sent.
# GROQ_API_KEY=

# Microsoft Agent Framework service (agent-service/). Defaults to http://127.0.0.1:8000
# AGENT_SERVICE_URL=http://127.0.0.1:8000
